+def _trace_transfer(operation, tag):
+    trace_dir = os.environ.get("K3_RL_TRACE_DIR")
+    function = getattr(_memory_saver, operation)
+    if not trace_dir:
+        return function(tag=tag)
+    torch.cuda.synchronize()
+    before_free, total = torch.cuda.mem_get_info()
+    started = time.monotonic()
+    result = function(tag=tag)
+    torch.cuda.synchronize()
+    seconds = time.monotonic() - started
+    after_free, _ = torch.cuda.mem_get_info()
+    record = {
+        "operation": operation,
+        "tag": tag,
+        "seconds": seconds,
+        "hostname": socket.gethostname(),
+        "gpu": torch.cuda.current_device(),
+        "before_used_bytes": total - before_free,
+        "after_used_bytes": total - after_free,
+        "memory_delta_bytes": after_free - before_free,
+        "timestamp": time.time(),
+    }
+    directory = Path(trace_dir)
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / f"rollout-tms-{socket.gethostname()}-{os.getpid()}.jsonl").open(
+        "a"
+    ) as stream:
+        stream.write(json.dumps(record) + "\n")
+    logger.info("K3_RL_TMS %s", json.dumps(record))
+    return result
